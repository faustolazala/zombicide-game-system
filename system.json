{
  "id": "zombicide",
  "title": "Zombicide Game System",
  "description": "A rules-engine foundation for running Zombicide missions in Foundry Virtual Tabletop.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13.351",
    "verified": "13.351",
    "maximum": "13.351"
  },
  "authors": [
    {
      "name": "Zombicide Game System contributors"
    }
  ],
  "esmodules": [
    "zombicide.mjs"
  ],
  "styles": [
    "styles/zombicide.css",
    "styles/sheets.css"
  ],
  "languages": [
    {
